rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasVerifiedCommunityEmail() {
      return currentUserProfileExists()
        && (
          request.auth.token.email_verified == true
          || currentUserProfile().data.emailVerified == true
        );
    }

    function hasVerifiedCommunityAge() {
      return currentUserProfileExists()
        && currentUserProfile().data.ageVerified == true
        && (
          !("ageVerificationStatus" in currentUserProfile().data)
          || currentUserProfile().data.ageVerificationStatus == null
          || currentUserProfile().data.ageVerificationStatus == ''
          || currentUserProfile().data.ageVerificationStatus == 'verified'
          || currentUserProfile().data.ageVerificationStatus == 'approved'
        );
    }

    function hasNoPendingCommunityDeletion() {
      return currentUserProfileExists()
        && (
          !("accountDeletionRequestedAt" in currentUserProfile().data)
          || currentUserProfile().data.accountDeletionRequestedAt == null
          || currentUserProfile().data.accountDeletionRequestedAt == ''
        );
    }

    function hasNoCommunityRestriction() {
      return currentUserProfileExists()
        && (
          !("moderationState" in currentUserProfile().data)
          || currentUserProfile().data.moderationState == null
          || currentUserProfile().data.moderationState == ''
          || currentUserProfile().data.moderationState == 'clear'
          || currentUserProfile().data.moderationState == 'review'
        );
    }

    function canReadCommunity() {
      return isSignedIn()
        && hasVerifiedCommunityEmail()
        && hasVerifiedCommunityAge()
        && hasNoPendingCommunityDeletion()
        && hasNoCommunityRestriction();
    }

    function canWriteCommunity() {
      return canReadCommunity();
    }

    function currentCommunityRules() {
      return get(/databases/$(database)/documents/communityConfig/rules);
    }

    function currentCommunityRulesAccepted() {
      return canReadCommunity()
        && exists(/databases/$(database)/documents/communityConfig/rules)
        && exists(/databases/$(database)/documents/communityRuleAcceptances/$(request.auth.uid))
        && get(/databases/$(database)/documents/communityRuleAcceptances/$(request.auth.uid)).data.latestAcceptedVersion == currentCommunityRules().data.version;
    }

    function isCommunityAdmin() {
      return currentUserProfileExists()
        && (
          ('isAdmin' in currentUserProfile().data && currentUserProfile().data.isAdmin == true)
          || ('role' in currentUserProfile().data && (
            currentUserProfile().data.role == 'admin'
            || currentUserProfile().data.role == 'moderator'
          ))
        );
    }

    function userDismissedTarget(sourceUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(sourceUid))
        && 'dismissedProfileIds' in get(/databases/$(database)/documents/users/$(sourceUid)).data
        && targetUid in get(/databases/$(database)/documents/users/$(sourceUid)).data.dismissedProfileIds;
    }

    function isMutuallyBlockedWith(targetUid) {
      return currentUserProfileExists()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && (
          userDismissedTarget(request.auth.uid, targetUid)
          || userDismissedTarget(targetUid, request.auth.uid)
        );
    }

    function canReadDates() {
      return currentCommunityRulesAccepted();
    }

    function isVisibleDate() {
      return 'creatorId' in resource.data
        && resource.data.creatorId is string
        && resource.data.status == 'active'
        && resource.data.scheduledAt is timestamp
        && resource.data.scheduledAt > request.time
        && !isMutuallyBlockedWith(resource.data.creatorId);
    }

    function roomIsActive(roomId) {
      return get(/databases/$(database)/documents/communityRooms/$(roomId)).data.active == true;
    }

    function hasReadableCommunityMessageExpiry() {
      return resource.data.keys().hasAll(['expiresAt'])
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function keepsPublicLocationRedacted() {
      return (
        !('latitude' in request.resource.data) || request.resource.data.latitude == null
      ) && (
        !('longitude' in request.resource.data) || request.resource.data.longitude == null
      );
    }

    function mapLocationFields() {
      return [
        'userId',
        'nickname',
        'profileImageUri',
        'age',
        'status',
        'searchActive',
        'visible',
        'online',
        'membership',
        'city',
        'travelMode',
        'coordinate',
        'geohash',
        'accuracyMeters',
        'updatedAt'
      ];
    }

    function isValidMapLocationPayload(uid) {
      return request.resource.data.keys().hasOnly(mapLocationFields())
        && request.resource.data.userId == uid
        && request.resource.data.coordinate is map
        && request.resource.data.coordinate.latitude is number
        && request.resource.data.coordinate.longitude is number
        && request.resource.data.geohash is string
        && request.resource.data.visible is bool
        && request.resource.data.searchActive is bool
        && request.resource.data.online is bool;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && keepsPublicLocationRedacted();
      allow update: if isOwner(uid) && keepsPublicLocationRedacted();
      allow delete: if false;
    }

    match /users/{uid}/private/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /mapLocations/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isValidMapLocationPayload(uid);
      allow delete: if isOwner(uid);
    }

    match /communityRooms/{roomId} {
      allow read: if canReadCommunity() && (resource.data.active == true || isCommunityAdmin());
      allow create, update, delete: if false;
    }

    match /communityRooms/{roomId}/messages/{messageId} {
      allow list: if currentCommunityRulesAccepted()
        && (roomIsActive(roomId) || isCommunityAdmin());
      allow get: if currentCommunityRulesAccepted()
        && (roomIsActive(roomId) || isCommunityAdmin())
        && hasReadableCommunityMessageExpiry();
      allow create, update, delete: if false;
    }

    match /communityRooms/{roomId}/messages/{messageId}/reactions/{reactionId} {
      allow read: if currentCommunityRulesAccepted() && (roomIsActive(roomId) || isCommunityAdmin());
      allow create, update, delete: if false;
    }

    match /communityRoomReads/{readId} {
      allow read: if currentCommunityRulesAccepted() && (resource.data.userId == request.auth.uid || isCommunityAdmin());
      allow create, update, delete: if false;
    }

    match /communityConfig/{docId} {
      allow read: if canReadCommunity() && docId == 'rules';
      allow create, update, delete: if false;
    }

    match /communityRuleAcceptances/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isCommunityAdmin());
      allow create, update, delete: if false;
    }

    match /communityRuleVersions/{versionId} {
      allow read: if isSignedIn() && isCommunityAdmin();
      allow create, update, delete: if false;
    }

    match /communityPresence/{uid} {
      allow read, create, update, delete: if false;
    }

    match /dates/{dateId} {
      allow get: if isSignedIn() && (
        isCommunityAdmin()
        || ('creatorId' in resource.data && resource.data.creatorId == request.auth.uid)
        || (canReadDates() && isVisibleDate())
      );
      allow list, create, update, delete: if false;
    }

    match /dates/{dateId}/interests/{interestUserId} {
      allow read, create, update, delete: if false;
    }

    match /communityRateLimits/{uid} {
      allow read, write: if false;
    }

    match /communityReportRateLimits/{uid} {
      allow read, write: if false;
    }

    match /communityBlocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /communityReports/{reportId} {
      allow read: if isSignedIn() && isCommunityAdmin();
      allow create, update, delete: if false;
    }

    match /communityModerationLogs/{logId} {
      allow read: if isSignedIn() && isCommunityAdmin();
      allow create, update, delete: if false;
    }

    match /communitySafetyStates/{uid} {
      allow read: if isSignedIn() && isCommunityAdmin();
      allow create, update, delete: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if isSignedIn()
        && collection != 'users'
        && collection != 'mapLocations'
        && collection != 'communityRooms'
        && collection != 'communityRoomReads'
        && collection != 'communityRateLimits'
        && collection != 'communityReportRateLimits'
        && collection != 'communityBlocks'
        && collection != 'communityConfig'
        && collection != 'communityPresence'
        && collection != 'dates'
        && collection != 'communityReports'
        && collection != 'communityRuleAcceptances'
        && collection != 'communityRuleVersions'
        && collection != 'communityModerationLogs'
        && collection != 'communitySafetyStates';
    }

    match /{collection}/{docId}/{document=**} {
      allow read, write: if isSignedIn()
        && collection != 'users'
        && collection != 'mapLocations'
        && collection != 'communityRooms'
        && collection != 'communityRoomReads'
        && collection != 'communityRateLimits'
        && collection != 'communityReportRateLimits'
        && collection != 'communityBlocks'
        && collection != 'communityConfig'
        && collection != 'communityPresence'
        && collection != 'dates'
        && collection != 'communityReports'
        && collection != 'communityRuleAcceptances'
        && collection != 'communityRuleVersions'
        && collection != 'communityModerationLogs'
        && collection != 'communitySafetyStates';
    }
  }
}